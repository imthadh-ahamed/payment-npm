# Enforce exact, reproducible installs across contributors and CI.
save-exact=true

# Fail fast on peer dependency issues instead of silently resolving them.
strict-peer-dependencies=true

# Prevent lifecycle scripts from running for transitive/unaudited packages;
# Husky's own "prepare" script is invoked explicitly and unaffected by this.
ignore-scripts=false

# pnpm: keep node_modules layout close to the npm hoisting model for
# compatibility with tooling that assumes a flat structure.
shamefully-hoist=false
